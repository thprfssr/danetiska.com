{# Lexerat inline parser and semantic emission; typography lives in the .sty. #}
{% set languages = {
 'pie':'PIE', 'lat':'Lat.', 'grc':'Anc. Gr.', 'grk':'Anc. Gr.',
 'rus':'Rus.', 'eng':'Eng.', 'fra':'Fr.', 'dnt':'Dan.', 'dan':'Danish',
 'ger':'Ger.', 'ita':'It.', 'cat':'Cat.', 'ara':'Ar.', 'per':'Pers.',
 'bg':'Bulg.', 'kyr':'Kyrg.', 'tur':'Turk.', 'protrk':'Proto-Turkic',
 'protung':'Proto-Tungusic', 'av':'Av.'
} %}
{% set double_args = ['grc','grk','rus','ara','per','bg','kyr','av','ex'] %}
{% set single_args = ['par','field','reg','chem','gloss','silentgloss','emph','textit','textbf'] %}
{% set zero_args = {'cf':'cf.', 'etc':'etc.', 'ono':'onomatopoeic', 'unknown':'unknown'} %}

{# Read one balanced {...} group, advancing a mutable cursor. #}
{% macro group(text, cursor) -%}
  {%- set g = namespace(depth=0, start=cursor.i+1, end=cursor.i, done=false) -%}
  {%- for j in range(cursor.i, text|length) -%}
    {%- if not g.done -%}
      {%- if text[j] == '{' -%}{%- set g.depth = g.depth+1 -%}
      {%- elif text[j] == '}' -%}
        {%- set g.depth = g.depth-1 -%}
        {%- if g.depth == 0 -%}{%- set g.end=j -%}{%- set g.done=true -%}{%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if g.done -%}
    {%- set cursor.value=text[g.start:g.end] -%}{%- set cursor.i=g.end+1 -%}
  {%- else -%}
    {%- set cursor.value=text[cursor.i+1:] -%}{%- set cursor.i=text|length -%}
  {%- endif -%}
{%- endmacro %}

{# Only punctuation adjoining omitted content is normalized. #}
{% set omitted = '\uE000' %}
{% macro tidy(text) -%}
  {%- set n = namespace(out='', pending='', hidden=false) -%}
  {%- for ch in text -%}
    {%- if ch in ' \t\r\n,;' or ch == omitted -%}
      {%- set n.pending = n.pending + ch -%}
      {%- if ch == omitted -%}{%- set n.hidden = true -%}{%- endif -%}
    {%- else -%}
      {%- if n.hidden -%}
        {%- if n.out and ch not in '.!?:)]}' and n.out[-1:] not in '([{' -%}
          {%- if ';' in n.pending -%}{%- set n.out = n.out + '; ' -%}
          {%- elif ',' in n.pending -%}{%- set n.out = n.out + ', ' -%}
          {%- else -%}{%- set n.out = n.out + ' ' -%}{%- endif -%}
        {%- endif -%}
      {%- else -%}{%- set n.out = n.out + n.pending -%}{%- endif -%}
      {%- set n.out = n.out + ch -%}
      {%- set n.pending = '' -%}{%- set n.hidden = false -%}
    {%- endif -%}
  {%- endfor -%}
  {{- n.out -}}{%- if not n.hidden -%}{{- n.pending -}}{%- endif -%}
{%- endmacro %}

{% macro inline(text, examples=none) -%}
  {%- set text = text or '' -%}
  {%- set c=namespace(i=0, value='') -%}
  {%- set rendered -%}
  {%- for unused in range(text|length) -%}
    {%- if c.i < text|length -%}
      {%- set ch=text[c.i] -%}
      {%- if ch in ['$','&'] -%}
        {%- set start=c.i -%}{%- set c.i=c.i+1 -%}
        {%- if c.i < text|length and text[c.i]=='{' -%}
          {{- group(text,c) -}}
        {%- else -%}
          {%- set word=namespace(end=c.i, done=false) -%}
          {%- for j in range(c.i,text|length) -%}
            {%- if not word.done and (text[j].isalnum() or text[j] in '_.:-') -%}
              {%- set word.end=j+1 -%}
            {%- else -%}{%- set word.done=true -%}{%- endif -%}
          {%- endfor -%}
          {%- set c.value=text[c.i:word.end] -%}{%- set c.i=word.end -%}
        {%- endif -%}
        {%- if not c.value -%}{{- ch|latex_escape -}}
        {%- elif ch=='$' -%}
          {%- if format=='html' -%}<span class="gloss">{{ inline(c.value, examples) }}</span>
          {%- else -%}\mygloss{ {{- inline(c.value, examples) -}} }{% endif -%}
        {%- elif format=='html' -%}<span class="silent-gloss" hidden>{{ inline(c.value, examples) }}</span>
        {%- else -%}{{- omitted -}}{% endif -%}
      {%- elif ch=='\\' -%}
        {%- set start=c.i -%}{%- set c.i=c.i+1 -%}
        {%- set name=namespace(end=c.i, done=false) -%}
        {%- for j in range(c.i,text|length) -%}
          {%- if not name.done and text[j] in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ' -%}
            {%- set name.end=j+1 -%}
          {%- else -%}{%- set name.done=true -%}{%- endif -%}
        {%- endfor -%}
        {%- set name=text[c.i:name.end] -%}{%- set c.i=c.i+name|length -%}
        {%- set a=namespace(values=[],done=false) -%}
        {%- for unused2 in range(text|length-c.i) -%}
          {%- if not a.done and c.i < text|length and text[c.i]=='{' -%}
            {{- group(text,c) -}}{%- set a.values=a.values+[c.value] -%}
          {%- else -%}{%- set a.done=true -%}{%- endif -%}
        {%- endfor -%}
        {%- set expected=2 if name in double_args else 0 if name in zero_args else 1 -%}
        {%- if name in languages and a.values|length >= expected -%}
          {%- set form = inline(a.values[0], examples) -%}
          {%- if name=='pie' or languages[name].startswith('Proto-') -%}
            {%- set form = '*' + form.lstrip() -%}
          {%- endif -%}
          {%- if format=='html' -%}
            {{- languages[name] }} <i{% if name in ['ara','per','av'] %} dir="rtl"{% endif %}>{{ form }}</i>{% if a.values|length > 1 %} <i>{{ inline(a.values[1], examples) }}</i>{% endif %}
          {%- else -%}
            {%- set texname='grc' if name=='grk' else name -%}
            \my{{ texname }}{ {{- form -}} }{% if name in double_args %}{ {{- inline(a.values[1], examples) -}} }{% endif %}
          {%- endif -%}
        {%- elif name in zero_args -%}
          {%- if format=='html' -%}{{- zero_args[name] -}}
          {%- else -%}\my{{ name }}{}{% endif -%}
        {%- elif name=='ex' and a.values|length >= 2 -%}
          {%- if examples is not none -%}
            {%- set examples.items = examples.items + [[a.values[0], a.values[1]]] -%}
            {{- omitted -}}
          {%- elif format=='html' -%}<span class="sample-phrase"><i>{{ inline(a.values[0], examples) }}</i> “{{ inline(a.values[1], examples) }}”</span>
          {%- else -%}\myex{ {{- inline(a.values[0], examples) -}} }{ {{- inline(a.values[1], examples) -}} }{% endif -%}
        {%- elif name in single_args and a.values -%}
          {%- if format=='latex' and name=='silentgloss' -%}{{- omitted -}}
          {%- elif format=='latex' -%}
            {%- set texname=name if name in ['emph','textit','textbf'] else 'my'+name -%}
            \{{ texname }}{ {{- inline(a.values[0], examples) -}} }
          {%- elif name=='chem' -%}(atomic number {{ inline(a.values[0], examples) }})
          {%- elif name=='silentgloss' -%}<span class="silent-gloss" hidden>{{ inline(a.values[0], examples) }}</span>
          {%- elif name=='gloss' -%}<span class="gloss">{{ inline(a.values[0], examples) }}</span>
          {%- elif name=='par' -%}<span class="qualifier">{{ inline(a.values[0], examples) }}</span>
          {%- elif name in ['field','reg'] -%}<i>({{ inline(a.values[0], examples) }})</i>
          {%- elif name=='textbf' -%}<b>{{ inline(a.values[0], examples) }}</b>
          {%- else -%}<i>{{ inline(a.values[0], examples) }}</i>{% endif -%}
        {%- else -%}{{- text[start:c.i]|latex_escape -}}{% endif -%}
        {%- if (name in languages or name in single_args or name in double_args or name in zero_args) and a.values|length > expected -%}
          {%- for extra in a.values[expected:] -%}{{- ('{'+extra+'}')|latex_escape -}}{%- endfor -%}
        {%- endif -%}
      {%- elif ch=='{' -%}
        {{- group(text,c) -}}{{- inline(c.value, examples) -}}
      {%- else -%}
        {{- ch|latex_escape -}}{%- set c.i=c.i+1 -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- endset -%}
  {{- tidy(rendered) -}}
{%- endmacro %}

{# Expand preposition case labels for display; source typ values stay unchanged. #}
{% macro type_label(value) -%}
  {%- if value.startswith('prep+') -%}
    prep.\nobreakspace w.\nobreakspace {{- ' ' -}}{{- value[5:] | trim | latex_escape -}}
  {%- else -%}{{- value | latex_escape -}}{%- endif -%}
{%- endmacro %}

{# Every sense keeps its own captured typ. Typ changes introduce a new block. #}
{% macro stop(text) -%}
  {%- if text.rstrip().rstrip('}').rstrip()[-1:] not in ['.', '!', '?', ';', ':'] -%}\unskip.{%- endif -%}
{%- endmacro %}
{% macro senses(item) -%}
{%- for definition in item.definitions -%}
{%- if not loop.first -%}
  {%- if definition.typ != item.definitions[loop.index0-1].typ -%}\RaeTypeDivider{}
  {%- else -%}\RaeSenseDivider{}
  {%- endif -%}
{%- endif -%}
{%- if definition.typ and (loop.first or definition.typ != item.definitions[loop.index0-1].typ) -%}
\mytyp{{ '{' }}{{ type_label(definition.typ) }}} {{ ' ' }}
{%- endif -%}
{%- if item.definitions|length > 1 -%}\LexeratSenseLabel{{ '{' }}{{ loop.index }}}{% endif -%}
{%- set body = inline(definition.content) | trim -%}
{{- body -}}{%- if body -%}{{- stop(body) -}}{%- endif -%}
{%- endfor -%}
{%- endmacro %}


{% set format='latex' %}
