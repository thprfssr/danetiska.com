% Danetian dictionary typography and semantic commands.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{danetian-dictionary}[2026/10/27 Danetian Academy dictionary]
\RequirePackage{xparse}
\RequirePackage{graphicx}
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{danetian-dictionary}{Use LuaLaTeX or XeLaTeX}{This dictionary requires Unicode fonts.}
\fi
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\RequirePackage{microtype}
\RequirePackage{enumitem}
\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{setspace}
\RequirePackage{ragged2e}
\RequirePackage{multicol}
\RequirePackage{hyperref}
\RequirePackage{markdown}
\newcommand{\dicttitlefont}{\normalfont}

% ---------- Page/layout ----------
\geometry{
  paperwidth=6in,
  paperheight=9in,
  left=0.7in,
  right=0.7in,
  top=0.75in,
  bottom=0.8in,
  headheight=14pt
}

\setstretch{1.0}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\itshape \rightmark}
\fancyhead[R]{\footnotesize\itshape \leftmark}
\fancyfoot[C]{\thepage}

\hypersetup{
  colorlinks=true,
  linkcolor=black,
  urlcolor=black,
  citecolor=black
}

% ---------- Fonts ----------
\IfFontExistsTF{Amiri}{\newfontfamily\arabicfont[Script=Arabic]{Amiri}}{\newfontfamily\arabicfont[Script=Arabic]{DejaVu Sans}}
\IfFontExistsTF{Noto Sans Avestan}{\newfontfamily\avestanfont[Script=Avestan]{Noto Sans Avestan}}{\newcommand{\avestanfont}{\PackageError{danetian-dictionary}{Noto Sans Avestan is required for Avestan text}{Install Noto Sans Avestan, then rebuild.}}}

\IfFontExistsTF{Charis SIL}{\setmainfont{Charis SIL}}{\setmainfont{DejaVu Serif}}
\IfFontExistsTF{Charis SIL}{\newfontfamily\danetianfont{Charis SIL}}{\newfontfamily\danetianfont{DejaVu Serif}}
\IfFontExistsTF{Charis SIL}{\newfontfamily\foreignfont{Charis SIL}}{\newfontfamily\foreignfont{DejaVu Serif}}
\IfFontExistsTF{Charis SIL}{\newfontfamily\cyrillicfont{Charis SIL}}{\newfontfamily\cyrillicfont{DejaVu Serif}}
\IfFontExistsTF{Gentium Plus}{\newfontfamily\greekfont{Gentium Plus}}{\newfontfamily\greekfont{DejaVu Serif}}

\setdefaultlanguage{english}
\setotherlanguages{greek,russian,arabic}

% ---------- Internal state ----------
\newcounter{dictsense}
\newif\ifinentry
\inentryfalse

\newcommand{\dictentrybreak}{%
  \par\addvspace{0.22\baselineskip}%
}

\newcounter{dictentry}

\makeatletter
\newcommand{\dictsensecount}[2]{%
	\expandafter\gdef\csname dictsenses@#1\endcsname{#2}%
	}

\newcommand{\dictsavesenses}{%
  \ifnum\value{dictentry}>0
    \immediate\write\@auxout{%
      \string\dictsensecount
        {\arabic{dictentry}}{\arabic{dictsense}}%
    }%
  \fi
}

\newcommand{\dictreset}{%
	\dictsavesenses
	\stepcounter{dictentry}%
	\setcounter{dictsense}{0}%
}

\newcommand{\dictsenselabel}[1]{%
	\ifcsname dictsenses@\arabic{dictentry}\endcsname
		\ifnum\csname dictsenses@\arabic{dictentry}\endcsname>1
			\textbf{#1.}\nobreak\hspace{0.3em}%
		\fi
	\fi
}

\makeatother
\AtEndDocument{\dictsavesenses}

% ---------- Entry macros ----------

\NewDocumentCommand{\myinfl}{o m}{%
}

\NewDocumentCommand{\mylink}{m}{%
}

\NewDocumentCommand{\mydef}{o m}{%
  \stepcounter{dictsense}%
  \IfNoValueTF{#1}
    {\dictsenselabel{\arabic{dictsense}}}
    {\dictsenselabel{#1}}%
  #2%
}

