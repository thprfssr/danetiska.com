\NewDocumentCommand{\mypp}{m}{}

\newcommand{\LexeratSenseLabel}[1]{\textbf{#1.}\nobreak\hspace{0.3em}}

\newenvironment{LexeratReverseMatches}{%
  \begin{itemize}[label=\(\circ\),leftmargin=1.1em,labelsep=0.35em,
    itemsep=0.15em,parsep=0pt,topsep=0.15em,partopsep=0pt]%
}{\end{itemize}}

% ---------- RAE-inspired compact typography ----------
\newfontfamily\lemmafont{DejaVu Sans}
\setlength{\columnsep}{1.4em}
\setlength{\multicolsep}{0pt}
\raggedcolumns
\emergencystretch=2em
\tolerance=1800
\widowpenalty=10000
\clubpenalty=10000
\newcommand{\RaeSenseDivider}{\unskip\hspace{0.4em}}
\newcommand{\RaeTypeDivider}{\unskip\hspace{0.4em}\raisebox{\depth}{\resizebox*{!}{1ex}{\ensuremath{\diamond}}}\nobreak\hspace{0.4em}}
\newcommand{\RaeExpressionDivider}{\unskip\hspace{0.4em}\rule{1ex}{1ex}\nobreak\hspace{0.4em}}
\newcommand{\RaeBetweenExpressions}{\unskip\hspace{0.4em}\rotatebox{45}{\rule{0.8ex}{0.8ex}}\nobreak\hspace{0.4em}}
\NewDocumentCommand{\mykey}{m m}{%
  \ifinentry\dictentrybreak\fi\inentrytrue\dictreset
  \hangindent=0.75em\hangafter=1\noindent
  \markboth{#1}{#1}%
  {\lemmafont\bfseries #1\ifstrempty{#2}{.}{,}}%
  \ifstrempty{#2}{}{\space{\danetianfont\bfseries #2.}}%
  \nobreak\hspace{0.35em}\ignorespaces
}
\NewDocumentCommand{\myexpr}{m}{%
  \ifinentry\dictentrybreak\fi\inentrytrue\dictreset
  \hangindent=0.75em\hangafter=1\noindent
  \markboth{#1}{#1}%
  {\danetianfont\bfseries #1.}\nobreak\hspace{0.35em}\ignorespaces
}
\NewDocumentCommand{\myety}{m}{{\small(\textit{#1})}\space\ignorespaces}
\NewDocumentCommand{\mytyp}{m}{\textit{#1.}\nobreakspace\ignorespaces}
\NewDocumentCommand{\mygloss}{m}{#1}
\NewDocumentCommand{\mypar}{m}{\textit{#1}}
\NewDocumentCommand{\mychem}{m}{\mypar{chem.\nobreakspace elem.\nobreakspace #1}}
\NewDocumentCommand{\mylat}{m}{{\foreignfont\textit{Lat.}\space #1}}
\NewDocumentCommand{\mypie}{m}{{\foreignfont\textit{PIE}\space #1}}
\NewDocumentCommand{\myeng}{m}{{\foreignfont\textit{Eng.}\space #1}}
\NewDocumentCommand{\myfra}{m}{{\foreignfont\textit{Fr.}\space #1}}
\NewDocumentCommand{\mygrc}{m m}{{\textit{Gk.}\space\textgreek{#1}\space#2}}
\NewDocumentCommand{\myrus}{m m}{{\textit{Rus.}\space{\cyrillicfont #1}\space#2}}
\NewDocumentCommand{\myrom}{m}{{\foreignfont\textit{Rom.}\space #1}}

\NewDocumentCommand{\mysilentgloss}{m}{}
\NewDocumentCommand{\myex}{m m}{\textit{#1}\space\textquotedblleft #2\textquotedblright}
\NewDocumentCommand{\myfield}{m}{\textit{#1.}\nobreakspace}
\NewDocumentCommand{\myreg}{m}{\textit{#1.}\nobreakspace}
\NewDocumentCommand{\LexeratLinkedExpression}{m m}{%
  {\danetianfont\bfseries #1.}\nobreak\hspace{0.35em}#2%
}
\NewDocumentCommand{\LexeratReverseHead}{m}{%
  \par\addvspace{0.22\baselineskip}%
  \hangindent=0.75em\hangafter=1\noindent
  \markboth{#1}{#1}%
  \noindent{\lemmafont\bfseries #1.}\nobreak\hspace{0.35em}\ignorespaces
}

\newcommand{\LexeratLetterHeading}[1]{%
  \par%
  \addvspace{2.5\baselineskip}%
  {\centering\normalfont\Huge\bfseries #1\par}%
  \nobreak\vspace{0.7\baselineskip}%
  \inentryfalse
}


% ---------- Book-level presentation ----------
% Metadata is supplied by the .tex template, not by the style.
\NewDocumentCommand{\DictionaryTitlePage}{m m m m}{%
  \hypersetup{pdftitle={#1 / #2},pdfauthor={Danetiska Academia}}%
  \begin{titlepage}
    \centering
    \vspace*{0.05in}
    {\dicttitlefont\bfseries\fontsize{23}{27}\selectfont\parbox{0.80\linewidth}{\centering #1}\par}
    \vspace{0.22in}
    {\dicttitlefont\fontsize{17}{21}\selectfont\itshape #2\par}
    \vspace{0.78in}
    \includegraphics[height=2.90in]{#3}\par
    \vfill
    \includegraphics[width=1.90in]{#4}\par
    \vspace*{0.14in}
  \end{titlepage}
}

% Shared heading style for preambles, contents, and dictionary directions.
\NewDocumentCommand{\DictionaryHeading}{m}{%
  {\centering\normalfont\huge\bfseries #1\par}%
  \vspace{1em}\thispagestyle{plain}%
}
% Omit the old closing signatures without modifying the external corpus.
% All other strong emphasis remains bold.
\NewDocumentCommand{\DictionaryPreambleStrong}{m}{%
  \ifstrequal{#1}{The Danetian Academy}{}{%
    \ifstrequal{#1}{Danetiska Academia}{}{\textbf{#1}}}%
}
\NewDocumentCommand{\DictionaryPreamble}{m}{%
  \clearpage\markboth{}{}%
  \begingroup
    \fontsize{9.5}{11.4}\selectfont
    \setlength{\parindent}{1em}%
    \setlength{\parskip}{0.35\baselineskip}%
    \markdownInput{#1}%
    \par
  \endgroup
  \clearpage
}
\markdownSetup{
  renderers={
    headingOne={\clearpage\phantomsection\addcontentsline{toc}{chapter}{#1}%
      \markboth{}{}\DictionaryHeading{#1}\noindent\ignorespaces},
    strongEmphasis={\DictionaryPreambleStrong{#1}},
    interblockSeparator={\par}
  }
}
\NewDocumentCommand{\DictionaryContents}{}{%
  \clearpage\markboth{}{}\DictionaryHeading{\contentsname}%
  \csname @starttoc\endcsname{toc}%
  \clearpage\markboth{}{}%
}
\NewDocumentCommand{\DictionarySection}{m}{%
  \clearpage\phantomsection\addcontentsline{toc}{chapter}{#1}%
  \markboth{}{}\inentryfalse\DictionaryHeading{#1}\RaggedRight
}
\endinput
