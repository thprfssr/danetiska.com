%\newfontfamily\cyrillicfont{Libertinus Serif}
\IfFontExistsTF{Amiri}{\newfontfamily\arabicfont[Script=Arabic]{Amiri}}{\newfontfamily\arabicfont[Script=Arabic]{DejaVu Sans}}
\IfFontExistsTF{Noto Sans Avestan}{\newfontfamily\avestanfont[Script=Avestan]{Noto Sans Avestan}}{\newfontfamily\avestanfont{DejaVu Sans}}


\IfFontExistsTF{Charis SIL}{\setmainfont{Charis SIL}}{\setmainfont{DejaVu Serif}}
\IfFontExistsTF{Charis SIL}{\newfontfamily\danetianfont{Charis SIL}}{\newfontfamily\danetianfont{DejaVu Serif}}
\IfFontExistsTF{Charis SIL}{\newfontfamily\foreignfont{Charis SIL}}{\newfontfamily\foreignfont{DejaVu Serif}}
\IfFontExistsTF{Charis SIL}{\newfontfamily\cyrillicfont{Charis SIL}}{\newfontfamily\cyrillicfont{DejaVu Serif}}
\IfFontExistsTF{Gentium Plus}{\newfontfamily\greekfont{Gentium Plus}}{\newfontfamily\greekfont{DejaVu Serif}}

\setdefaultlanguage{english}
\setotherlanguages{greek,russian,arabic}

% ---------- Internal state ----------
\newcounter{dictsense}
\newif\ifinentry
\inentryfalse

\newcommand{\dictentrybreak}{%
  \par\addvspace{0.22\baselineskip}%
}


\newcounter{dictentry}

\makeatletter
\newcommand{\dictsensecount}[2]{%
	\expandafter\gdef\csname dictsenses@#1\endcsname{#2}%
	}

\newcommand{\dictsavesenses}{%
  \ifnum\value{dictentry}>0
    \immediate\write\@auxout{%
      \string\dictsensecount
        {\arabic{dictentry}}{\arabic{dictsense}}%
    }%
  \fi
}

\newcommand{\dictreset}{%
	\dictsavesenses
	\stepcounter{dictentry}%
	\setcounter{dictsense}{0}%
}

\newcommand{\dictsenselabel}[1]{%
	\ifcsname dictsenses@\arabic{dictentry}\endcsname
		\ifnum\csname dictsenses@\arabic{dictentry}\endcsname>1
			\textbf{#1.}\nobreak\hspace{0.3em}%
		\fi
	\fi
}

\makeatother
\AtEndDocument{\dictsavesenses}

% ---------- Entry macros ----------
\NewDocumentCommand{\mykey}{m}{%
  \ifinentry\dictentrybreak\fi
  \inentrytrue
  \dictreset
  \markboth{#1}{#1}%
  {\danetianfont\bfseries #1.}%
}

\NewDocumentCommand{\myexpr}{m}{%
  \ifinentry\dictentrybreak\fi
  \inentrytrue
  \dictreset
  \markboth{#1}{#1}%
  {\danetianfont\bfseries #1}%
  \nobreak\hspace{0.5em}%
  {\normalfont expr.}%
}

\NewDocumentCommand{\myety}{m}{%
%  \par
%  \hangindent=2em\hangafter=1
%  \hspace*{1.2em}
	{\footnotesize [\textit{#1}]}%
}

\NewDocumentCommand{\myinfl}{o m}{%
%  \nobreak\hspace{0.6em}%
%  {\footnotesize\color{gray}%
%    \IfNoValueTF{#1}
%      {[infl.\ #2]}
%      {[infl.\ class~#1: #2]}%
%  }%
}

\NewDocumentCommand{\mytyp}{m}{%
  \nobreak%\hspace{0.6em}%
  %{\footnotesize\scshape #1}%
  \textit{#1.}
}

\NewDocumentCommand{\mylink}{m}{%
%  \par
%  \hangindent=2em\hangafter=1
%  \hspace*{1.2em}{\footnotesize\itshape Cf. forms}~#1%
}

\NewDocumentCommand{\mydef}{o m}{%
  \stepcounter{dictsense}%
  \IfNoValueTF{#1}
    {\dictsenselabel{\arabic{dictsense}}}
    {\dictsenselabel{#1}}%
  #2%
}

% ---------- Inline semantic/usage macros ----------
\NewDocumentCommand{\mypar}{m}{%
%  {\space\textnormal{\footnotesize\itshape #1}}%
  \textit{#1}
}

\NewDocumentCommand{\myfield}{m}{%
  {\footnotesize\textsc{#1}}\nobreakspace
}

\NewDocumentCommand{\myreg}{m}{%
  {\footnotesize\textsc{#1}}\nobreakspace
}

\NewDocumentCommand{\mygloss}{m}{%
  \emph{#1}%
}

\NewDocumentCommand{\mysilentgloss}{m}{%
  {\color{gray}\emph{#1}}%
}

\NewDocumentCommand{\myex}{m m}{%
%  \par
%  \hspace*{2.7em}%
  {\footnotesize\textquotedblleft #1\textquotedblright\enspace---\enspace#2}%
}

% ---------- Small utility tags ----------
\NewDocumentCommand{\mycf}{}{%
  \textit{cf.}\space
}

\NewDocumentCommand{\myetc}{}{%
  \textit{etc.}%
}

\NewDocumentCommand{\myunknown}{}{%
  \textit{unknown origin}%
}

\NewDocumentCommand{\mychem}{m}{%
%  {\footnotesize\textsc{el.~#1}}%
  \mypar{chem.\nobreakspace elem.\nobreakspace #1}
}

% ---------- Source-language / label tags ----------
% 1-arg forms
\NewDocumentCommand{\mylat}{m}{{\foreignfont\textit{Lat.}\space #1}}
\NewDocumentCommand{\mypie}{m}{{\foreignfont\textit{PIE}\space #1}}
\NewDocumentCommand{\mydnt}{m}{{\danetianfont #1}}
\NewDocumentCommand{\myeng}{m}{{\foreignfont\textit{Eng.}\space #1}}
\NewDocumentCommand{\myfra}{m}{{\foreignfont\textit{Fr.}\space #1}}
\NewDocumentCommand{\myger}{m}{{\foreignfont\textit{Ger.}\space #1}}
\NewDocumentCommand{\myita}{m}{{\foreignfont\textit{It.}\space #1}}
\NewDocumentCommand{\mybg}{m m}{{\foreignfont\textit{Bulg.}~#1~#2}}
\NewDocumentCommand{\mycat}{m}{{\foreignfont\textit{Cat.}\space #1}}
\NewDocumentCommand{\mydan}{m}{{\foreignfont\textit{Dan.}\space #1}}
\NewDocumentCommand{\mykyr}{m m}{{\foreignfont\textit{Kyrg.}~#1~#2}}
\NewDocumentCommand{\myono}{}{{\textit{onom.}}}
\NewDocumentCommand{\myprotrk}{m}{{\foreignfont\textit{Proto-Turkic}\space #1}}
\NewDocumentCommand{\myprotung}{m}{{\foreignfont\textit{Proto-Tungusic}\space #1}}
\NewDocumentCommand{\mytur}{m}{{\foreignfont\textit{Tur.}\space #1}}
\NewDocumentCommand{\myara}{m m}{{\textit{Ar.}~\textarabic{#1}~#2}}
\NewDocumentCommand{\myper}{m m}{{\textit{Pers.}~\textarabic{#1}~#2}}
\NewDocumentCommand{\mygrc}{m m}{{\textit{Gk.}~\textgreek{#1}~#2}}
\NewDocumentCommand{\myrus}{m m}{{\textit{Rus.}~{\cyrillicfont #1}~#2}}
\NewDocumentCommand{\myav}{m m}{{\textit{Av.}~{\avestanfont #1}~#2}}

% ---------- Fallbacks for future macros ----------
% These are harmless placeholders so the document compiles even if your exporter
% emits tags you have not styled yet.
\NewDocumentCommand{\mysyn}{m}{%
  \par\hangindent=2em\hangafter=1
  \hspace*{1.2em}{\footnotesize\itshape Syn.}~#1%
}

\NewDocumentCommand{\mylinknote}{m}{%
  \par\hangindent=2em\hangafter=1
  \hspace*{1.2em}{\footnotesize\itshape Note}~#1%
}


\NewDocumentCommand{\mypp}{m}{}

\newcommand{\LexeratSenseLabel}[1]{\textbf{#1.}\nobreak\hspace{0.3em}}

% Embedded expressions do not reset the lemma's sense counter or running header.
\NewDocumentCommand{\LexeratLinkedExpression}{m m}{%
  \par\begingroup
  \hangindent=1.2em\hangafter=1
  \noindent\textbullet\enspace{\danetianfont\bfseries #1}%
  \nobreak\hspace{0.5em}{\normalfont expr.}\enspace
  #2\par\endgroup
}


% Reverse headings do not reset the Danetian sense counters.
\NewDocumentCommand{\LexeratReverseHead}{m}{%
  \par\addvspace{0.65\baselineskip}%
  \markboth{#1}{#1}%
  \noindent\textbf{\textit{#1}}\par\nopagebreak[4]%
}
\newenvironment{LexeratReverseMatches}{%
  \begin{itemize}[label=\(\circ\),leftmargin=1.1em,labelsep=0.35em,
    itemsep=0.15em,parsep=0pt,topsep=0.15em,partopsep=0pt]%
}{\end{itemize}}


% ---------- RAE-inspired compact typography ----------
% The RAE dossier uses National and Tiempos Text. Retain Charis SIL for the
% multilingual body, and use an available sans serif for the headwords.
\newfontfamily\lemmafont{DejaVu Sans}
\setlength{\columnsep}{1.4em}
\setlength{\multicolsep}{0pt}
\raggedcolumns
\emergencystretch=2em
\tolerance=1800
\widowpenalty=10000
\clubpenalty=10000
% Plain spacing between same-type senses; hollow diamond at type changes.
\newcommand{\RaeSenseDivider}{\unskip\hspace{0.4em}}
\newcommand{\RaeTypeDivider}{\unskip\hspace{0.4em}\raisebox{\depth}{\resizebox*{!}{1ex}{\ensuremath{\diamond}}}\nobreak\hspace{0.4em}}
% Filled square opens the expressions section; filled diamonds separate phrases.
\newcommand{\RaeExpressionDivider}{\unskip\hspace{0.4em}\rule{1ex}{1ex}\nobreak\hspace{0.4em}}
\newcommand{\RaeBetweenExpressions}{\unskip\hspace{0.4em}\rotatebox{45}{\rule{0.8ex}{0.8ex}}\nobreak\hspace{0.4em}}
% Only the primary form uses the heading font; other forms match reverse matches.
\RenewDocumentCommand{\mykey}{m m}{%
  \ifinentry\dictentrybreak\fi\inentrytrue\dictreset
  \hangindent=0.75em\hangafter=1\noindent
  \markboth{#1}{#1}%
  {\lemmafont\bfseries #1\ifstrempty{#2}{.}{,}}%
  \ifstrempty{#2}{}{\space{\danetianfont\bfseries #2.}}%
  \nobreak\hspace{0.35em}\ignorespaces
}
\RenewDocumentCommand{\myexpr}{m}{%
  \ifinentry\dictentrybreak\fi\inentrytrue\dictreset
  \hangindent=0.75em\hangafter=1\noindent
  \markboth{#1}{#1}%
  {\danetianfont\bfseries #1.}\nobreak\hspace{0.35em}\ignorespaces
}
\RenewDocumentCommand{\myety}{m}{{\small\textit{(From #1)}}\space\ignorespaces}
\RenewDocumentCommand{\mytyp}{m}{\textit{#1.}\nobreakspace\ignorespaces}
\RenewDocumentCommand{\mygloss}{m}{#1}
\RenewDocumentCommand{\mypar}{m}{\textit{#1}}
\RenewDocumentCommand{\mychem}{m}{\mypar{chem.\nobreakspace elem.\nobreakspace #1}}
% Language labels and transliterations may wrap in narrow dictionary columns.
\RenewDocumentCommand{\mylat}{m}{{\foreignfont\textit{Lat.}\space #1}}
\RenewDocumentCommand{\mypie}{m}{{\foreignfont\textit{PIE}\space #1}}
\RenewDocumentCommand{\myeng}{m}{{\foreignfont\textit{Eng.}\space #1}}
\RenewDocumentCommand{\myfra}{m}{{\foreignfont\textit{Fr.}\space #1}}
\RenewDocumentCommand{\mygrc}{m m}{{\textit{Gk.}\space\textgreek{#1}\space#2}}
\RenewDocumentCommand{\myrus}{m m}{{\textit{Rus.}\space{\cyrillicfont #1}\space#2}}

\RenewDocumentCommand{\mysilentgloss}{m}{}
\RenewDocumentCommand{\myex}{m m}{\textit{#1}\space\textquotedblleft #2\textquotedblright}
\RenewDocumentCommand{\myfield}{m}{\textit{#1.}\nobreakspace}
\RenewDocumentCommand{\myreg}{m}{\textit{#1.}\nobreakspace}
\RenewDocumentCommand{\LexeratLinkedExpression}{m m}{%
  {\danetianfont\bfseries #1.}\nobreak\hspace{0.35em}#2%
}
\RenewDocumentCommand{\LexeratReverseHead}{m}{%
  \par\addvspace{0.22\baselineskip}%
  \hangindent=0.75em\hangafter=1\noindent
  \markboth{#1}{#1}%
  \noindent{\lemmafont\bfseries #1.}\nobreak\hspace{0.35em}\ignorespaces
}

% Pass letter headings to multicols so its space check precedes the heading.
\newcommand{\LexeratLetterHeading}[1]{%
  \par%
  \addvspace{2.5\baselineskip}%
  {\centering\normalfont\Huge\bfseries #1\par}%
  \nobreak\vspace{0.7\baselineskip}%
  \inentryfalse
}

